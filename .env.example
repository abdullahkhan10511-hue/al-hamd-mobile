# ==============================================================================
# AL-HAMD SHOP — Environment Configuration Template
# Copy this file to .env or .env.local and populate the values.
# NEVER commit real credentials, passwords, or production secrets to Git.
# ==============================================================================

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# ------------------------------------------------------------------------------
# Security & Authentication Secrets
# ------------------------------------------------------------------------------
# Generate a secret:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Optional legacy auth secret fallback
AUTH_SECRET=
ADMIN_JWT_SECRET=

# Administrator initial setup / root configuration
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NEW_PASSWORD=
ALLOW_PRODUCTION_SEED=false

# ------------------------------------------------------------------------------
# MySQL Database Configuration
# ------------------------------------------------------------------------------
# Full connection string format (e.g. mysql://user:password@host:3306/dbname)
DATABASE_URL=

# Or discrete MySQL parameters:
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_CONNECTION_LIMIT=10

# Alternative environment variable aliases supported by hosting providers:
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
MYSQL_CONNECT_TIMEOUT=10000

# ------------------------------------------------------------------------------
# Application & Storefront URL
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://alhamdshop.com

# ------------------------------------------------------------------------------
# Reverse Proxy & Rate Limiting
# ------------------------------------------------------------------------------
# Set TRUST_PROXY=true ONLY if deployed behind a trusted reverse proxy (Cloudflare, Nginx, ALB).
# When false (default), proxy headers are not trusted to prevent IP spoofing.
TRUST_PROXY=false
# Number of reverse proxy hops to trust (default: 1). Counted from the right side of X-Forwarded-For.
TRUSTED_PROXY_HOPS=1

# ------------------------------------------------------------------------------
# SMTP / Email Service Configuration
# ------------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_PASS=
SMTP_FROM=
SMTP_SECURE=false

# Alternative Mail provider aliases:
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_PASS=
MAIL_FROM=
EMAIL_WEBHOOK_URL=

# ------------------------------------------------------------------------------
# File Storage & Uploads
# ------------------------------------------------------------------------------
MEDIA_STORAGE_PATH=
PERSISTENT_UPLOADS_DIR=

# ------------------------------------------------------------------------------
# Persistent Data Directory (Task D1)
# ------------------------------------------------------------------------------
# Absolute path to a persistent storage directory outside the deployed application root.
# On hosting platforms (e.g., Hostinger VPS/cPanel/cloud instances), GitHub redeployments
# can recreate the application directory and reset runtime JSON settings (such as payment methods)
# back to repository defaults. Set DATA_DIR to an external persistent directory to ensure
# runtime settings survive across redeployments.
# On first run, existing runtime JSON files in <root>/data will be seeded once into DATA_DIR.
# Example for Linux/Hostinger: DATA_DIR=/home/u123456789/alhamd_data
# Example for Windows: DATA_DIR=C:\alhamd_data
# DATA_DIR=

UPLOADS_DIR=

# ------------------------------------------------------------------------------

# ------------------------------------------------------------------------------
# Headless Browser / Automation (Optional)
# ------------------------------------------------------------------------------
CHROME_PATH=
TARGET_URL=

# Optional: Comma-separated list of additional external image hostnames permitted in Next.js Image Optimization.
# Empty by default because all store media is served locally from /uploads/.
IMAGE_REMOTE_HOSTS=

# ------------------------------------------------------------------------------
# Staff Two-Factor Authentication & Access Control (Step 14 Phase 1)
# ------------------------------------------------------------------------------
# 32+ byte encryption key for encrypting staff TOTP secrets with AES-256-GCM
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOTP_ENC_KEY=

# Optional comma-separated IP allowlist for /admin and /api/admin
# ADMIN_IP_ALLOWLIST=127.0.0.1,::1

# Allow env-based admin login (ADMIN_EMAIL/ADMIN_PASSWORD) in production.
# Default is false (disabled in production; only real database staff accounts can log in).
ALLOW_ENV_ADMIN_LOGIN=false

# ------------------------------------------------------------------------------
# Content Security Policy (CSP) Mode
# ------------------------------------------------------------------------------
# Set CSP_ENFORCE=true to actively block CSP policy violations with Content-Security-Policy.
# When false (default), the site operates in report-only mode (Content-Security-Policy-Report-Only),
# reporting policy violations to /api/csp-report without blocking resources.
CSP_ENFORCE=false
# Emergency escape hatch to disable enforcing CSP if external third-party scripts fail
DISABLE_STRICT_CSP=false

# ------------------------------------------------------------------------------
# Production Data Migration Safety Lock (Task S19)
# ------------------------------------------------------------------------------
# WARNING: MUST STAY UNSET OR FALSE ON THE LIVE PRODUCTION SERVER!
# When set to true in production, it temporarily enables /api/admin/migrate-data.
# Leaving this enabled poses a severe production risk of overwriting live store data.
# The predeploy check (scripts/predeploy-check.mjs) strictly fails if this is set to true.
ALLOW_DATA_MIGRATION=false
