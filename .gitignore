# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug & logs
*.log
*.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# development, mock & test data files
data/*.json
!data/README.md

# database dumps & test SQL
*.sql
*.dump
*.sqlite
!scripts/migrations/*.sql

# test & scratch scripts
scripts/test-*
scripts/patch-*
scripts/fix-*
scratch/
_security_backups/

# persistent uploaded media (keep directories, ignore user uploaded files)
uploads/
/public/uploads/*
!/public/uploads/.gitkeep
!/public/uploads/**/.gitkeep

# Security reports & verification scripts
STEP*-REPORT.md
scripts/verify-*
