# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# development, mock & test data files
data/dev-*.json
data/test-*.json
data/mock-*.json
data/*.local.json
data/customers.json
data/staff-users.json

# database dumps & test SQL
*.sql
*.dump
*.sqlite

# test & scratch scripts
scripts/test-*.js
scripts/test-*.ts

# persistent uploaded media (keep directories, ignore user uploaded files)
/public/uploads/*/*
!/public/uploads/**/.gitkeep


